# ============================================================
# KP Kids Studio — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WhatsApp Business API (Meta Cloud API) ───────────────────
# DO NOT RENAME OR REMOVE THESE — WhatsApp system depends on them
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_system_user_token
WA_WEBHOOK_VERIFY_TOKEN=your_chosen_verify_token_string
WA_APP_SECRET=your_app_secret_from_meta

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MAX_INPUT_TOKENS=3000
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_CONVERSATION_BUDGET=20000

# ── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ── Site / Deployment ────────────────────────────────────────
SITE_URL=https://senior-madeleine-matabar-93648cd5.koyeb.app

# ── Email Notifications ──────────────────────────────────────
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
STUDIO_NOTIFICATION_EMAIL=studio_owner@gmail.com

# ── Studio Info ──────────────────────────────────────────────
STUDIO_NAME=KP Kids Studio
STUDIO_WHATSAPP=+250700000000
STUDIO_LOCATION=Kigali
STUDIO_HOURS=Mon-Sat 9AM-6PM
BOOKING_FEE_RWF=20000

# ── Web Push Notifications (VAPID) ───────────────────────────
VAPID_PUBLIC_KEY=BOKxjsL2V3-5rMX78Ncc...
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIMS_EMAIL=admin@kpkidsstudio.rw

# ── Instagram DM Bot (NEW — to be configured) ────────────────
# Get these from Meta Business Manager after linking Instagram
# to your Facebook Page and enabling Messenger API for Instagram
IG_PAGE_ACCESS_TOKEN=your_page_access_token
IG_APP_SECRET=your_app_secret_same_as_WA_or_different
IG_WEBHOOK_VERIFY_TOKEN=your_ig_verify_token
IG_PAGE_ID=your_facebook_page_id
IG_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
